{
  "lore.item.name.water_in_the_lake": "湖中水",
  "lore.item.intro.water_in_the_lake.1": "小湖中无声的涟漪。",
  "lore.item.name.shattered_crystal": "破碎水晶",
  "lore.item.intro.shattered_crystal.1": "水晶的一部分，闪烁但是逐渐消逝，",
  "lore.item.intro.shattered_crystal.2": "等待着它身处阴影中的另一半...",
  "lore.item.intro.shattered_crystal.3": "每击中一个敌人，获得5秒生命恢复I，",
  "lore.item.intro.shattered_crystal.4": "最多15秒。",
  "lore.item.intro.shattered_crystal.3.ex": "每击中一个敌人，获得4秒生命恢复II，",
  "lore.item.intro.shattered_crystal.4.ex": "最多20秒。",
  "lore.item.name.essence_of_sakura_feather": "樱羽之粹",
  "lore.item.intro.essence_of_sakura_feather.1": "水中蕴藏着冻结的羽毛，",
  "lore.item.intro.essence_of_sakura_feather.2": "其中的美丽早已消逝。",
  "lore.item.name.liquid_gray_stone": "液态灰石",
  "lore.item.intro.liquid_gray_stone.1": "由奇怪的被污染的液体组成，",
  "lore.item.intro.liquid_gray_stone.2": "其中的混合物让周围的生物难以靠近。",
  "lore.item.name.void_time_water": "虚时水",
  "lore.item.intro.void_time_water.1": "论时间本质，",
  "lore.item.intro.void_time_water.2": "我们目睹原子日复一日的律动。",
  "lore.item.name.winter_of_solitude": "孤独之冬",
  "lore.item.intro.winter_of_solitude.1": "冰封小径之上，落雪携星一同坠下。",
  "lore.item.intro.winter_of_solitude.2": "行人匆匆而过，遗下一路孤寂的痕迹……",
  "lore.item.name.natsumatsuri": "夏日祭",
  "lore.item.intro.natsumatsuri.1": "孩子们围绕篝火起舞，",
  "lore.item.intro.natsumatsuri.2": "萤火虫混迹人群，与天使同贺。",
  "lore.item.name.gravity_core": "引力核",
  "lore.item.intro.gravity_core.1": "来自每个维度的每个角落，所有的回忆，",
  "lore.item.intro.gravity_core.2": "都在核心中变成了宇宙的碎片。",
  "lore.item.intro.gravity_core.3": "着地时，将附近所有敌人拉至中心。",
  "lore.item.name.moonlight_vial": "月露瓶",
  "lore.item.intro.moonlight_vial.1": "你可于瓶中，一览至净无瑕的月光。",
  "lore.item.name.wisdom_spirits": "智慧精灵",
  "lore.item.intro.wisdom_spirits.1": "瓶中精灵的声音让每个拥有过它的人都感到困惑。",
  "lore.item.intro.wisdom_spirits.2": "没有人尝试过理解他们的思绪。",
